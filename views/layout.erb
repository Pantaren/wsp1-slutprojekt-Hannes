<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fruktparadiset</title>
    <link rel="stylesheet" type="text/css" href="/style.css?<%=Time.now.to_i%>">
</head>
<body>
    <header>
        <h1 class="logo">Second Hand</h1>
    </header>
    <hr>
    <nav>
        <ul>
            <li><a href="/">Startsida</a></li>
            <li><a href="/users">Användare</a></li>
            <li><a href="/categories">Kategorier</a></li>
            
            <% if @current_user %>
                <li><a href="/clothes/new">Skapa en annons</a></li>
                <li><a href="/users/<%= @current_user['id'] %>">Mitt konto</a></li>
                <li>
                  <form class="delete" action="/logout" method="post">
                    <input type="submit" value="Logga ut">
                  </form>
                </li>
            <% else %>
                <li><a href="/users/new">Registrera</a></li>
                <li><a href="/login">Logga in</a></li>
            <% end %>
        </ul>
    </nav>
    <hr>
    <%= yield %>
    <hr>
    <footer>
        <p>Kontakta oss</p>
    </footer>
</body>
</html>
