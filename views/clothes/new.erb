<h2>Ny annons</h2>

<form action="/clothes" method="post">
	<label>Titel <input type="text" name="title"></label>
	<label>Beskrivning <input type="text" name="description"></label>
	<label>Bild url <input type="text" name="image"></label>
	<input type="submit" value="Spara">

    <ul>
        <% @category.each do |cat| %>
          <li>
            <label><%= cat['name'] %><input type="checkbox" name="category_ids[]" value="<%= cat['id'] %>"></label>
          </li>
        <% end %>
    </ul>
</form>

