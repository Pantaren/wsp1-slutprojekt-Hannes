<ul>
<% @clothes.each do |cloth| %>
  <li>
    <a href="/clothes/<%= cloth['id'] %>"><%= cloth['title'] %></a>
    
    <form class="delete" action="/clothes/<%=cloth["id"]%>/delete" method="post">
       		<input type="submit" value="Ta bort">
   	</form>
    <form class="edit" action="/clothes/<%=cloth["id"]%>/edit" method="get">
       		<input type="submit" value="Redigera">
   	</form>
  </li>
<% end %>
</ul>
