<ul>
<% @cat_piece.each do |cat_article| %>
  <li>
    <a href="/clothes/<%= cat_article['id'] %>"><%= cat_article['title'] %></a>
    <img src="/img/<%= cat_article['image'] %>" alt="<%= cat_article['title'].capitalize %>" height="100px">

    <form class="delete" action="/clothes/<%=cat_article["id"]%>/delete" method="post">
       		<input type="submit" value="Ta bort">
   	</form>
    <form class="edit" action="/clothes/<%=cat_article["id"]%>/edit" method="get">
       		<input type="submit" value="Redigera">
   	</form>
  </li>
<% end %>
</ul>