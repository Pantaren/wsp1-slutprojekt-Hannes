<form action="/users/<%= @user['id'] %>/update" method="post">
	<label>Username <input type="text" name="username" value="<%= @user['username'] %>"></label>
	<label>Description <input type="text" name="description" value="<%= @user['description'] %>"></label>
    <label>Lösenord <input type="password" name="password"></label>
	<label>Nytt Lösenord <input type="password" name="password_new"></label>
	<input type="submit" value="Spara">
</form>